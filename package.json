{
  "name": "emu-war-animated-short",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:bridge": "remotion render src/index.ts BridgeShort out/bridge.mp4",
    "stills:bridge": "node scripts/bridge-stills.mjs out/bridge/b_ 100,400,1100 0.5",
    "check": "tsc --noEmit",
    "stills:emu": "node scripts/bridge-stills.mjs out/emu/shot01_ 0,18,35 0.5 EmuWarOpening",
    "render:emu:preview": "remotion render src/index.ts EmuWarOpening out/emu/shot01-preview.mp4 --scale 0.5",
    "render:emu:final": "remotion render src/index.ts EmuWarOpening out/emu/shot01.mp4 --scale 1.3333"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "@remotion/cli": "4.0.290",
    "@remotion/three": "4.0.290",
    "@remotion/bundler": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "postprocessing": "6.39.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/three": "^0.175.0",
    "typescript": "^5.7.0"
  }
}
